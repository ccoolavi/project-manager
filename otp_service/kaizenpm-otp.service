[Unit]
Description=WhatsApp OTP Gateway for KaizenPM
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/project_manager/otp_service
ExecStart=/usr/bin/node /home/ubuntu/projects/project_manager/otp_service/wa-otp.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=PB_URL=http://127.0.0.1:8090
Environment=PB_ADMIN_EMAIL=avisolat18@gmail.com
Environment=PB_ADMIN_PASSWORD=admin123123

[Install]
WantedBy=multi-user.target
