# Database
DATABASE_URL=sqlite:///./kaizenpm.db
# For PostgreSQL: postgresql://user:password@localhost/kaizenpm

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=https://your-github-pages-url.com/project-manager/

# Environment
ENVIRONMENT=production
DEBUG=false

# Email (optional for invites)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# App
APP_NAME=KaizenPM API
APP_VERSION=1.0.0
