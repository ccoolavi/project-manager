#!/usr/bin/env python3
import os
import sys
import requests
import json
import subprocess
import datetime
import shutil

PB_URL = os.getenv("PB_URL", "http://127.0.0.1:8090")
WORKSPACE = os.path.dirname(os.path.abspath(__file__))
PB_BINARY = os.path.join(WORKSPACE, "pocketbase")

def print_help():
    print("PM-CLI (PocketBase Management Wrapper)")
    print("Usage:")
    print("  pm-cli start-pb")
    print("  pm-cli stop-pb")
    print("  pm-cli status")
    print("  pm-cli list-projects [token]")
    print("  pm-cli create-user <email> <password> [name]")
    print("  pm-cli delete-user <user_id> <admin_token>")
    print("  pm-cli create-org <name> [description]")
    print("  pm-cli list-orgs [token]")
    print("  pm-cli add-member <org_id> <user_id> [role]")
    print("  pm-cli list-members <org_id> [token]")
    print("  pm-cli create-subproject <project_id> <name> [description]")
    print("  pm-cli list-subprojects <project_id> [token]")
    print("  pm-cli backup-db")

def start_pb():
    try:
        p = subprocess.Popen([PB_BINARY, "serve", "--http=127.0.0.1:8090"],
                             cwd=WORKSPACE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        print(json.dumps({"ok": True, "message": "PocketBase started", "pid": p.pid}))
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))

def stop_pb():
    try:
        subprocess.run(["pkill", "-f", "pocketbase"], check=False)
        print(json.dumps({"ok": True, "message": "PocketBase stopped"}))
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))

def status():
    try:
        r = requests.get(f"{PB_URL}/api/health", timeout=3)
        print(json.dumps({"ok": r.ok, "status_code": r.status_code, "body": r.json() if r.text else None}))
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))

def list_projects(token=None):
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        res = requests.get(f"{PB_URL}/api/collections/projects/records", headers=headers)
        if res.status_code == 200:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def create_user(email, password, name="User"):
    data = {
        "email": email,
        "password": password,
        "passwordConfirm": password,
        "name": name,
        "emailVisibility": True
    }
    try:
        res = requests.post(f"{PB_URL}/api/collections/users/records", json=data)
        if res.status_code in [200, 201]:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def delete_user(user_id, token):
    headers = {"Authorization": f"Bearer {token}"}
    try:
        res = requests.delete(f"{PB_URL}/api/collections/users/records/{user_id}", headers=headers)
        if res.status_code == 204:
            print(json.dumps({"success": True, "deleted": user_id}))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def create_org(name, description=""):
    token = os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN") or os.getenv("TOKEN")
    owner_id = os.getenv("USER_ID") or os.getenv("OWNER_ID") or os.getenv("PB_USER_ID")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    data = {"name": name, "description": description}
    if owner_id:
        data["owner"] = owner_id
    try:
        res = requests.post(f"{PB_URL}/api/collections/organizations/records", json=data, headers=headers)
        if res.status_code in [200, 201]:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def list_orgs(token=None):
    token = token or os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        res = requests.get(f"{PB_URL}/api/collections/organizations/records", headers=headers)
        if res.status_code == 200:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def add_member(org_id, user_id, role="member"):
    token = os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    data = {"organization": org_id, "user": user_id, "role": role}
    try:
        res = requests.post(f"{PB_URL}/api/collections/organization_members/records", json=data, headers=headers)
        if res.status_code in [200, 201]:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def list_members(org_id, token=None):
    token = token or os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        res = requests.get(f"{PB_URL}/api/collections/organization_members/records?filter=(organization='{org_id}')", headers=headers)
        if res.status_code == 200:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def create_subproject(project_id, name, description=""):
    token = os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN")
    user_id = os.getenv("USER_ID") or os.getenv("PB_USER_ID")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    data = {"project": project_id, "name": name, "description": description, "status": "active"}
    if user_id:
        data["user"] = user_id
    try:
        res = requests.post(f"{PB_URL}/api/collections/sub_projects/records", json=data, headers=headers)
        if res.status_code in [200, 201]:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def list_subprojects(project_id, token=None):
    token = token or os.getenv("ADMIN_TOKEN") or os.getenv("PB_TOKEN")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        res = requests.get(f"{PB_URL}/api/collections/sub_projects/records?filter=(project='{project_id}')", headers=headers)
        if res.status_code == 200:
            print(json.dumps(res.json(), indent=2))
        else:
            print(f"Error [{res.status_code}]: {res.text}")
    except Exception as e:
        print(f"Connection error: {e}")

def backup_db():
    try:
        backup_name = f"pb_backup_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.tar.gz"
        subprocess.run(["tar", "-czf", os.path.join(WORKSPACE, backup_name), "-C", WORKSPACE, "pb_data"], check=True)
        print(json.dumps({"ok": True, "file": backup_name}))
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)
    
    cmd = sys.argv[1]
    if cmd == "start-pb":
        start_pb()
    elif cmd == "stop-pb":
        stop_pb()
    elif cmd == "status":
        status()
    elif cmd == "list-projects":
        token = sys.argv[2] if len(sys.argv) > 2 else None
        list_projects(token)
    elif cmd == "create-user":
        if len(sys.argv) < 4:
            print("Usage: pm-cli create-user <email> <password> [name]")
            sys.exit(1)
        create_user(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "User")
    elif cmd == "delete-user":
        if len(sys.argv) < 3:
            print("Usage: pm-cli delete-user <user_id> <admin_token>")
            sys.exit(1)
        delete_user(sys.argv[2], sys.argv[3])
    elif cmd == "create-org":
        if len(sys.argv) < 3:
            print("Usage: pm-cli create-org <name> [description]")
            sys.exit(1)
        create_org(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "")
    elif cmd == "list-orgs":
        token = sys.argv[2] if len(sys.argv) > 2 else None
        list_orgs(token)
    elif cmd == "add-member":
        if len(sys.argv) < 4:
            print("Usage: pm-cli add-member <org_id> <user_id> [role]")
            sys.exit(1)
        add_member(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "member")
    elif cmd == "list-members":
        if len(sys.argv) < 3:
            print("Usage: pm-cli list-members <org_id> [token]")
            sys.exit(1)
        token = sys.argv[3] if len(sys.argv) > 3 else None
        list_members(sys.argv[2], token)
    elif cmd == "create-subproject":
        if len(sys.argv) < 4:
            print("Usage: pm-cli create-subproject <project_id> <name> [description]")
            sys.exit(1)
        create_subproject(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "")
    elif cmd == "list-subprojects":
        if len(sys.argv) < 3:
            print("Usage: pm-cli list-subprojects <project_id> [token]")
            sys.exit(1)
        token = sys.argv[3] if len(sys.argv) > 3 else None
        list_subprojects(sys.argv[2], token)
    elif cmd == "backup-db":
        backup_db()
    else:
        print_help()
